NODE_ENV=
# Server-side API base (optional). Production: https://your-backend.onrender.com
BACKEND_URL=
# Browser + server default API URL. Production: same as BACKEND_URL.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_USE_MOCK_DATA=
NEXT_PUBLIC_CROSSMINT_API_KEY=
NEXT_PUBLIC_FLOW_NETWORK=
# Set to "true" once Paystack keys are configured on the backend (wallet funding uses live checkout)
NEXT_PUBLIC_PAYSTACK_LIVE=
